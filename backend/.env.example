PORT=4000

# MongoDB must be a replica set (even single-node) for multi-document transactions
# used by scoring recompute + approval routing + audit logging.
# Local single-node replica set example:
#   mongod --dbpath ./data/db --replSet rs0 --port 27017
#   then once: mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/dealflow360?replicaSet=rs0

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Tunables referenced in Rules.md — never hardcode these in service logic
SCORE_SCALE_FACTOR=10
APPROVAL_BAND_MANAGER_MAX=15
STALL_THRESHOLD_DAYS=5
ANOMALY_Z_THRESHOLD=2.0
SLIPPAGE_BUFFER_DAYS=2

CLIENT_ORIGIN=http://localhost:5173
